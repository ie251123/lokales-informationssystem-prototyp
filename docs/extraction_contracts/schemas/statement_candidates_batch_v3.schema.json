{
  "title": "Statement Candidates Batch v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_version",
    "contract_version",
    "batch_binding",
    "node_processing",
    "candidates",
    "relations"
  ],
  "properties": {
    "package_version": { "const": "statement_candidates_batch_v3" },
    "contract_version": { "const": "statement_candidates_batch_v3" },
    "batch_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "document_id",
        "document_version_id",
        "document_sha256",
        "batch_manifest_sha256",
        "batch_id",
        "batch_number",
        "total_batches",
        "target_node_ids",
        "context_node_ids",
        "model_name",
        "prompt_version",
        "input_sha256",
        "prompt_sha256",
        "batch_sha256"
      ],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "document_id": { "type": "string", "minLength": 1 },
        "document_version_id": { "type": "string", "minLength": 1 },
        "document_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "batch_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "batch_id": { "type": "string", "pattern": "^batch_[0-9]{3,}$" },
        "batch_number": { "type": "integer", "minimum": 1 },
        "total_batches": { "type": "integer", "minimum": 1 },
        "target_node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "context_node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "model_name": { "type": "string", "minLength": 1 },
        "prompt_version": { "const": "statement_candidates_frontier_v3" },
        "input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "batch_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "node_processing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_node_id", "status", "candidate_ids"],
        "properties": {
          "document_node_id": { "type": "string", "minLength": 1 },
          "status": {
            "enum": [
              "processed_with_candidates",
              "processed_without_candidate",
              "excluded_non_citable",
              "failed"
            ]
          },
          "candidate_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "document_node_id",
          "evidence",
          "statement_type",
          "statement_subtype",
          "normalized_text",
          "binding_status",
          "lifecycle_status",
          "review_status",
          "action_state",
          "output_constraint",
          "objects",
          "values",
          "conditions",
          "classifications",
          "groups",
          "relations",
          "document_references",
          "review_notes",
          "validation_warnings"
        ],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "document_node_id": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_text", "char_start", "char_end", "source_role"],
            "properties": {
              "source_text": { "type": "string", "minLength": 1 },
              "char_start": { "type": ["integer", "null"], "minimum": 0 },
              "char_end": { "type": ["integer", "null"], "minimum": 0 },
              "source_role": { "enum": ["primary", "supporting"] }
            }
          },
          "statement_type": {
            "enum": ["requirement", "planning_measure", "finding", "decision"]
          },
          "statement_subtype": {
            "enum": [
              "general_requirement",
              "egress_width",
              "fire_resistance",
              "planned_component",
              "source_assessment",
              "technical_value",
              "administrative_decision"
            ]
          },
          "normalized_text": { "type": "string", "minLength": 1 },
          "binding_status": { "enum": ["binding", "unknown"] },
          "lifecycle_status": { "const": "active" },
          "review_status": { "const": "needs_review" },
          "action_state": {
            "type": ["string", "null"],
            "enum": ["planned", "to_be_verified", "documented", null]
          },
          "output_constraint": { "type": ["string", "null"] },
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "object_id",
                "entity_type",
                "canonical_label",
                "aliases",
                "role"
              ],
              "properties": {
                "object_id": { "type": "string", "minLength": 1 },
                "entity_type": {
                  "enum": [
                    "building",
                    "storey",
                    "space",
                    "use_unit",
                    "door",
                    "building_component",
                    "cost_item",
                    "project_metric"
                  ]
                },
                "canonical_label": { "type": "string", "minLength": 1 },
                "aliases": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "role": { "enum": ["subject", "object", "scope", "reference"] }
              }
            }
          },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value_name",
                "raw_value",
                "text_value",
                "numeric_value",
                "unit",
                "comparison_operator",
                "is_approximate",
                "spatial_reference",
                "value_order"
              ],
              "properties": {
                "value_name": {
                  "enum": [
                    "maximum_distance",
                    "height",
                    "cantilever_each_side",
                    "fire_resistance_class",
                    "raw_table_value",
                    "count"
                  ]
                },
                "raw_value": { "type": "string", "minLength": 1 },
                "text_value": { "type": ["string", "null"] },
                "numeric_value": { "type": ["number", "null"] },
                "unit": { "type": ["string", "null"] },
                "comparison_operator": {
                  "enum": ["equals", "at_least", "at_most", "greater_than", "less_than"]
                },
                "is_approximate": { "type": "boolean" },
                "spatial_reference": { "type": ["string", "null"] },
                "value_order": { "type": "integer", "minimum": 1 }
              },
              "oneOf": [
                {
                  "properties": {
                    "text_value": { "type": "string" },
                    "numeric_value": { "type": "null" }
                  }
                },
                {
                  "properties": {
                    "text_value": { "type": "null" },
                    "numeric_value": { "type": "number" }
                  }
                }
              ]
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["condition_text", "parameters"],
              "properties": {
                "condition_text": { "type": "string", "minLength": 1 },
                "parameters": { "type": "object" }
              }
            }
          },
          "classifications": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scheme", "code", "label", "role"],
              "properties": {
                "scheme": { "type": "string", "minLength": 1 },
                "code": { "type": "string", "minLength": 1 },
                "label": { "type": ["string", "null"] },
                "role": { "enum": ["topic", "object_class", "source_class"] }
              }
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "group_id",
                "group_type",
                "label",
                "member_role",
                "member_rank"
              ],
              "properties": {
                "group_id": { "type": "string", "minLength": 1 },
                "group_type": { "enum": ["topic_cluster", "alternative_set"] },
                "label": { "type": "string", "minLength": 1 },
                "member_role": { "enum": ["primary", "supporting", "alternative"] },
                "member_rank": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["note"],
              "properties": {
                "note": { "type": "string", "minLength": 1 }
              }
            }
          },
          "document_references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reference_text", "reference_type"],
              "properties": {
                "reference_text": { "type": "string", "minLength": 1 },
                "reference_type": { "enum": ["normative", "internal", "appendix"] },
                "target_document_id": { "type": ["string", "null"] },
                "target_document_node_id": { "type": ["string", "null"] }
              }
            }
          },
          "review_notes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "validation_warnings": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation_id",
          "source_candidate_id",
          "target_candidate_id",
          "relation_type"
        ],
        "properties": {
          "relation_id": { "type": "string", "minLength": 1 },
          "source_candidate_id": { "type": "string", "minLength": 1 },
          "target_candidate_id": { "type": "string", "minLength": 1 },
          "relation_type": {
            "enum": [
              "addresses",
              "derived_from",
              "implements_decision",
              "supersedes",
              "conflicts_with"
            ]
          }
        }
      }
    }
  }
}
