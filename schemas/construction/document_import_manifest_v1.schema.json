{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-information-system/schemas/construction/document_import_manifest_v1.schema.json",
  "title": "Document Import Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "project", "document", "import", "profile"],
  "properties": {
    "manifest_version": { "const": "document_import_manifest_v1" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "name"],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "title", "file_type"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "file_type": { "const": "pdf" },
        "source_path": { "type": "string", "minLength": 1 }
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set_current", "allow_new_version_for_same_document"],
      "properties": {
        "set_current": { "type": "boolean" },
        "allow_new_version_for_same_document": { "type": "boolean" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "expected_page_count",
        "text_repair_rules_version",
        "search_normalization_rules_version",
        "sections",
        "empty_pages",
        "non_evidence_pages"
      ],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "expected_page_count": { "type": "integer", "minimum": 1 },
        "text_repair_rules_version": { "const": "source_text_repair_v1" },
        "search_normalization_rules_version": {
          "const": "search_text_normalization_v1"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section_number", "heading", "page_start", "page_end"],
            "properties": {
              "section_number": { "type": "string", "minLength": 1 },
              "heading": { "type": "string", "minLength": 1 },
              "page_start": { "type": "integer", "minimum": 1 },
              "page_end": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "empty_pages": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true
        },
        "non_evidence_pages": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true
        },
        "excluded_text_blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page", "label", "raw_text"],
            "properties": {
              "page": { "type": "integer", "minimum": 1 },
              "label": { "type": "string", "minLength": 1 },
              "raw_text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "glyph_repairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page", "raw_text", "replacement_text"],
            "properties": {
              "page": { "type": "integer", "minimum": 1 },
              "raw_text": { "type": "string", "minLength": 1 },
              "replacement_text": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
