{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-information-system/schemas/construction/statement_candidate_batch_input_v2.schema.json",
  "title": "Statement Candidate Batch Input v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_version",
    "contract_version",
    "prompt_version",
    "project_id",
    "document_id",
    "document_version_id",
    "document_sha256",
    "document_nodes_package_sha256",
    "batch_manifest_sha256",
    "batch_id",
    "batch_number",
    "total_batches",
    "batch_sha256",
    "target_node_ids",
    "context_node_ids",
    "source_nodes",
    "instructions",
    "package_sha256"
  ],
  "properties": {
    "package_version": { "const": "statement_candidate_batch_input_v2" },
    "contract_version": { "const": "statement_candidates_batch_v2" },
    "prompt_version": { "const": "statement_candidates_frontier_v2" },
    "project_id": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "document_version_id": { "type": "string", "minLength": 1 },
    "document_sha256": { "$ref": "#/$defs/sha256" },
    "document_nodes_package_sha256": { "$ref": "#/$defs/sha256" },
    "batch_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "batch_id": { "type": "string", "pattern": "^batch_[0-9]{3,}$" },
    "batch_number": { "type": "integer", "minimum": 1 },
    "total_batches": { "type": "integer", "minimum": 1 },
    "batch_sha256": { "$ref": "#/$defs/sha256" },
    "target_node_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "context_node_ids": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/source_node" }
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_status",
        "source_text_only",
        "context_only_is_source",
        "candidate_id_prefix"
      ],
      "properties": {
        "review_status": { "const": "needs_review" },
        "source_text_only": { "const": true },
        "context_only_is_source": { "const": false },
        "candidate_id_prefix": { "type": "string", "pattern": "^batch_[0-9]{3,}:$" }
      }
    },
    "package_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_node_id",
        "node_rank",
        "node_role",
        "node_path",
        "page",
        "section_number",
        "heading",
        "locator",
        "source_text",
        "content_sha256"
      ],
      "properties": {
        "document_node_id": { "type": "string", "minLength": 1 },
        "node_rank": { "type": "integer", "minimum": 1 },
        "node_role": { "enum": ["target", "context_only"] },
        "node_path": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "section_number": { "type": ["string", "null"] },
        "heading": { "type": ["string", "null"] },
        "locator": { "type": ["string", "null"] },
        "source_text": { "type": "string", "minLength": 1 },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
