# Runtime defaults for the local prototype.
# The prototype must run without a real model by default.
DATABASE_PATH=data/processed/prototype.sqlite
TEXT_ARTIFACTS_PATH=data/processed/text
LLM_PROVIDER=none

# Deterministic extractive answer mode. LLM generation can be added later
# through the adapter interface.
ANSWER_MODE=deterministic_extractive

# Retrieval defaults.
RETRIEVAL_TOP_K=5

# Persist ask/retrieval runs for traceability and later evaluation.
# Set to false for privacy-sensitive local data.
RUN_LOGGING_ENABLED=true

# Optional local model runtime. Only used when LLM_PROVIDER=llama_cpp.
# The path must point to an existing local GGUF file. Do not download models
# during application runtime.
LLM_MODEL_PATH=
